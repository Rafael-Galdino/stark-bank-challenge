# Stark Bank
STARKBANK_PROJECT_ID=seu-project-id-aqui
STARKBANK_PRIVATE_KEY_PATH=./privateKey.pem
STARKBANK_ENVIRONMENT=sandbox

# GCP
GCP_PROJECT_ID=seu-projeto-gcp
INTERNAL_AUTH_AUDIENCE=https://seu-servico.run.app

# Servidor
PORT=8080
LOG_LEVEL=info

# Scheduler
SCHEDULER_CYCLE_MINUTES=180
SCHEDULER_TOTAL_PERIOD=1440
# SCHEDULER_START_AT=2024-01-15T09:00:00-03:00
SCHEDULER_DEADLINE_GRACE_MINUTES=1
# Tamanho do lote de invoices por ciclo (regra final do desafio: 8-12)
SCHEDULER_MIN_INVOICES=8
SCHEDULER_MAX_INVOICES=12
